# Copy to private terraform.tfvars only when that file does not exist.
data_center_id = "REPLACE_WITH_REAL_DATA_CENTER_ID"

# Default: Terraform creates a protected 100 GB Network Volume.
network_volume_id      = null
network_volume_size_gb = 100

# Pods are manually created in Console with these exact official tags:
# GPU: vllm/vllm-openai:v0.26.0
# CPU: prom/prometheus:v3.5.0
# CPU: grafana/grafana:12.1.0
gpu_pod_id        = null
prometheus_pod_id = null
grafana_pod_id    = null

# Actual GitHub repository and a published commit containing this bootstrap.
# No repository snapshot or custom image is required on either CPU Pod.
repository_url      = null
repository_revision = null
awq_source_revision = null
awq_gdrive_source   = null

# RUNPOD_API_KEY, rclone credentials, Grafana administrator passwords and
# Grafana API tokens must never be added to tfvars or Terraform outputs.
